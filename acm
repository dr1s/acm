#!/usr/bin/env bash
#
# Unified AzerothCore server management command.
#
# Usage: ./acm <command> [options]
#

SCRIPT_DIR="$(cd "$(dirname "${0}")" && pwd)"
export SCRIPT_DIR

show_usage() {
    cat <<'EOF'
Usage: ./acm <command> [options]

Commands:
  setup              Clone/update repos and rebuild the stack
  start              Start the compose stack
  run                Start stack, launch game, wait, backup, shutdown
  stop               Stop the running stack
  backup             Backup databases and configs
  restore            Restore a database backup
  bundle             Install/manage bundles (e.g. paragon)
  create-account     Create a new WoW account with GM level 3
  console            Attach to the running worldserver console
  help               Show this help message

Run './acm <command> --help' for command-specific options.
EOF
}

if [ $# -eq 0 ]; then
    show_usage
    exit 1
fi

if [ -z "${BASH_VERSION:-}" ] || [ "${BASH_VERSINFO[0]:-0}" -lt 4 ]; then
    echo "acm requires Bash 4.2 or newer." >&2
    echo "Install a newer bash and run: bash ./acm ..." >&2
    exit 1
fi

source "${SCRIPT_DIR}/lib/utils/init.sh"

main() {
    local COMMAND="${1}"
    shift

    case "${COMMAND}" in
        help|-h|--help)
            show_usage
            exit 0
            ;;
        *)
            local COMMAND_FILE="${SCRIPT_DIR}/lib/commands/${COMMAND}.sh"
            if [ ! -f "${COMMAND_FILE}" ]; then
                log_error "Command implementation not found: ${COMMAND_FILE}"
                show_usage
                exit 1
            fi
            # shellcheck disable=SC1090
            source "${COMMAND_FILE}"
            local FUNCTION="command_${COMMAND//-/_}"
            "${FUNCTION}" "$@"
            ;;
    esac
}

main "$@"
