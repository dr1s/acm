# Autoenv leave file.
# Reverses the changes made by .env when leaving the directory.

if [ -n "${BASH_VERSION:-}" ]; then
    if [ -n "${ACM_COMPLETION_FILE:-}" ]; then
        # Remove the acm source from the front of PROMPT_COMMAND.
        PROMPT_COMMAND="${PROMPT_COMMAND#source ${ACM_COMPLETION_FILE}; }"
        unset ACM_COMPLETION_FILE
    fi
elif [ -n "${ZSH_VERSION:-}" ]; then
    unset ACM_COMPLETION_FILE

    # Remove this directory from fpath if present.
    fpath=(${fpath:#${PWD}/completions})

    # Disable the acm completion function if compinit is available.
    if (( $+functions[compdef] )); then
        compdef -d acm 2>/dev/null || true
    fi
fi
