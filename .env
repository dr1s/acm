# Autoenv / direnv file for acm shell completion.
#
# - autoenv sources this directly in your interactive shell.
# - direnv evaluates this in a bash subshell and exports environment changes
#   (including PROMPT_COMMAND) to your interactive shell.

export ACM_COMPLETION_FILE="${PWD}/completions/acm"

if [ -n "${ZSH_VERSION:-}" ]; then
    # zsh: add the local completions directory to fpath.  Only initialize the
    # completion system once per shell; re-running compinit can reset the
    # current keymap and produce "undefined-key" errors for custom widgets
    # (e.g. fzf).
    fpath+=("${PWD}/completions")
    # _comp_setup is created when compinit has already run in this shell.
    # Re-initializing completion can reset custom keymaps/widgets, so only
    # run compinit when it hasn't been set up yet.  If compinit is already
    # active, register the acm completion function directly with compdef
    # so the newly added fpath entry is picked up.
    if ! typeset -p _comp_setup >/dev/null 2>&1; then
        autoload -Uz compinit 2>/dev/null || true
        compinit 2>/dev/null || true
    elif (( $+functions[compdef] )); then
        # compinit already ran, so the new fpath entry wasn't scanned.  Mark
        # _acm for autoload and register it for the acm command.
        autoload -Uz _acm 2>/dev/null || true
        compdef _acm acm 2>/dev/null || true
    fi
elif [ -n "${BASH_VERSION:-}" ]; then
    # bash: hook into PROMPT_COMMAND so the completion file is sourced in the
    # interactive shell. This works for both autoenv and direnv.
    if [[ ":${PROMPT_COMMAND}:" != *":source ${ACM_COMPLETION_FILE}:"* ]]; then
        export PROMPT_COMMAND="source ${ACM_COMPLETION_FILE}; ${PROMPT_COMMAND}"
    fi
fi
