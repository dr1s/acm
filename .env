# Autoenv / direnv file for acm shell completion.
#
# - autoenv sources this directly in your interactive shell.
# - direnv evaluates this in a bash subshell and exports environment changes
#   (including PROMPT_COMMAND) to your interactive shell.

export ACM_COMPLETION_FILE="${PWD}/completions/acm"

if [ -n "${ZSH_VERSION:-}" ]; then
    # zsh: add the local completions directory to fpath and initialize the
    # completion system so completions/_acm is picked up.
    fpath+=("${PWD}/completions")
    autoload -Uz compinit 2>/dev/null || true
    compinit 2>/dev/null || true
elif [ -n "${BASH_VERSION:-}" ]; then
    # bash: hook into PROMPT_COMMAND so the completion file is sourced in the
    # interactive shell. This works for both autoenv and direnv.
    if [[ ":${PROMPT_COMMAND}:" != *":source ${ACM_COMPLETION_FILE}:"* ]]; then
        export PROMPT_COMMAND="source ${ACM_COMPLETION_FILE}; ${PROMPT_COMMAND}"
    fi
fi
